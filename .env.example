# ==========================================
# BINARIES - SYMPOSIUM GAME ENVIRONMENT CONFIG
# ==========================================

# Application Port and Host
PORT=3000
NODE_ENV=development

# Admin Authentication
# Change these for production!
ADMIN_EMAIL=admin@binaries.com
ADMIN_PASSWORD=BinariesAdmin2026!
ADMIN_SECURITY_CODE=BINARIES2026

# Session Security Secret (Generate random 32+ char string in production)
SESSION_SECRET=super_secret_binaries_symposium_session_key_987654321

# Database Provider ('sqlite' or 'firestore')
DATABASE_PROVIDER=sqlite
SQLITE_DB_PATH=./data/binaries.db

# Optional Firebase Firestore Configuration (if DATABASE_PROVIDER=firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
